# Only track AHG plugins
/*
!/.gitignore
!/README.md
!/ahg*/
!/docs/

# Track the deploy helper so it ships with the repo (other bin/ scripts stay local).
!/bin/
/bin/*
!/bin/link-plugins.sh

# Dependencies and build artifacts
node_modules/
.sass-cache/
*.patch

# Backup and temporary files
.backups/
*.bak
*.bak.*
*.bak2
*.old
*.broken
*.qubit
*.snippets
*.orig
*.tmp
*~

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# PHP tools
.php-cs-fixer.cache
.phpunit.result.cache

# OS files
.DS_Store
Thumbs.db
!/testing/
!/.github/
__pycache__/
*.pyc

# Generated by atom-framework/bin/build-runtime-plugin from the framework
# source and its vendor tree. A build artifact, not source: 6,505 files and
# ~1M lines that change wholesale on every framework release.
ahgRuntimePlugin/

# Working files. Git already holds every previous version; a .bak of a
# routing.yml or a plugin configuration class is a second copy the loader might
# plausibly read, and it costs somebody an afternoon during a debugging session.
*.bak
*.orig
*.old
*.rej
