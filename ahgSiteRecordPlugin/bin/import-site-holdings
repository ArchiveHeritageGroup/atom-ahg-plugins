#!/usr/bin/env php
<?php

/**
 * Create an archival description per catalogue row, with its site as creator.
 *
 * A row in the Wits catalogue is a HOLDING, not a site. The site is already an
 * authority record carrying the locality (see import-site-catalogue); this adds
 * the thing that is actually catalogued, browsed and searched, and links it to
 * the site through a creation event so the two stay related rather than
 * duplicated.
 *
 *   description  <- information_object, one per row
 *      creator   <- event(type = creation, actor_id = the site)
 *
 * Descriptions are created through QubitInformationObject rather than raw SQL:
 * the table is a nested set with a base `object` row, a slug and i18n, and an
 * INSERT that skips any of those produces a record that exists and is
 * unreachable.
 *
 * Dry run unless --apply is given.
 *
 *   php plugins/ahgSiteRecordPlugin/bin/import-site-holdings --file=holdings.csv
 *   php plugins/ahgSiteRecordPlugin/bin/import-site-holdings --file=... --apply
 */
$root = getcwd();
if (!is_file($root.'/config/ProjectConfiguration.class.php')) {
    fwrite(STDERR, "Run from the AtoM root.\n");

    exit(2);
}
require_once $root.'/config/ProjectConfiguration.class.php';

$opts = ['file' => null, 'apply' => false, 'limit' => 0];
foreach (array_slice($argv, 1) as $a) {
    if ('--apply' === $a) { $opts['apply'] = true; continue; }
    if (0 === strpos($a, '--file=')) { $opts['file'] = substr($a, 7); continue; }
    if (0 === strpos($a, '--limit=')) { $opts['limit'] = (int) substr($a, 8); continue; }
}
if (!$opts['file'] || !is_readable($opts['file'])) {
    fwrite(STDERR, "--file must point at a readable CSV\n");

    exit(2);
}

$configuration = ProjectConfiguration::getApplicationConfiguration('qubit', 'prod', false);
sfContext::createInstance($configuration);

// Indexing during a bulk create throws from inside base AtoM on every insert,
// and the row is written before it throws - so a "failed" run leaves orphans.
// AtoM's own importBulkTask does the same. Reindex afterwards.
if (class_exists('QubitSearch')) {
    QubitSearch::disable();
}

\AhgCore\Core\AhgDb::init();
$db = \Illuminate\Database\Capsule\Manager::connection();

$fh = fopen($opts['file'], 'r');
$head = fgetcsv($fh);
$col = array_flip($head);

$created = $skipped = $noSite = $linked = 0;
$errors = [];
$n = 0;

while (false !== ($r = fgetcsv($fh))) {
    if ($opts['limit'] && $n >= $opts['limit']) { break; }
    ++$n;

    $get = function ($k) use ($r, $col) {
        return isset($col[$k]) ? trim((string) ($r[$col[$k]] ?? '')) : '';
    };

    $siteNumber = $get('site_number');
    $title = $get('title');
    if ('' === $title) { ++$skipped; continue; }

    // Already imported? Match on the identifier so a re-run updates nothing and
    // duplicates nothing.
    $exists = $db->table('information_object')->where('identifier', $siteNumber)->first();
    if ($exists) { ++$skipped; continue; }

    // The site this holding came from, via the site record created earlier.
    $siteRecord = $siteNumber
        ? $db->table('ahg_site_record')->where('site_number', $siteNumber)->first()
        : null;
    if (!$siteRecord) { ++$noSite; }

    ++$created;
    if (!$opts['apply']) { continue; }

    try {
        $io = new QubitInformationObject();
        $io->parentId = QubitInformationObject::ROOT_ID;
        $io->title = $title;
        $io->identifier = $siteNumber ?: null;
        $io->levelOfDescriptionId = null;

        // Collection detail, as scope and content. Kept as labelled lines rather
        // than prose: it is catalogue data, and inventing sentences around it
        // would misrepresent what the spreadsheet actually says.
        $scope = [];
        foreach ([
            'period' => 'Period',
            'culture' => 'Industry/culture',
            'site_type' => 'Site type',
            'artefacts' => 'Artefacts',
            'organic' => 'Organic remains',
            'samples' => 'Samples',
            'rock_art' => 'Rock art',
            'c14' => 'C14',
            'media' => 'Slides, pictures, reports',
            'permits' => 'Permits',
        ] as $k => $label) {
            if ('' !== $get($k)) { $scope[] = $label.': '.$get($k); }
        }
        if ($scope) { $io->scopeAndContent = implode("\n", $scope); }

        if ('' !== $get('boxes')) { $io->extentAndMedium = $get('boxes').' box(es)'; }

        $acq = [];
        foreach (['donor' => 'Donor', 'excavator' => 'Excavator', 'accession_date' => 'Accession date'] as $k => $label) {
            if ('' !== $get($k)) { $acq[] = $label.': '.$get($k); }
        }
        if ($acq) { $io->acquisition = implode("\n", $acq); }

        $where = array_filter([$get('collection_location'), $get('location')]);
        if ($where) { $io->locationOfOriginals = implode(' / ', $where); }

        $io->save();

        // Creator link: an event of type creation carrying the site's actor.
        if ($siteRecord) {
            $event = new QubitEvent();
            $event->objectId = $io->id;
            $event->actorId = $siteRecord->actor_id;
            $event->typeId = QubitTerm::CREATION_ID;
            $event->save();
            ++$linked;
        }
    } catch (\Throwable $e) {
        $errors[] = $siteNumber.': '.substr($e->getMessage(), 0, 110);
        --$created;
    }
}
fclose($fh);

printf("\n    rows read                    %6d\n", $n);
printf("    %s %6d\n", $opts['apply'] ? 'descriptions created        ' : 'would create                ', $created);
printf("    linked to a site as creator  %6d\n", $linked);
printf("    no matching site record      %6d\n", $noSite);
printf("    skipped (no title/existing)  %6d\n", $skipped);
if ($errors) {
    printf("    ERRORS                       %6d\n", count($errors));
    foreach (array_slice($errors, 0, 5) as $e) { echo "      {$e}\n"; }
}
echo $opts['apply']
    ? "\n    APPLIED - indexing was disabled, run: php symfony search:populate\n"
    : "\n    Dry run - nothing written. Add --apply.\n";
