{
    "name": "Seadragon Viewer",
    "machine_name": "ahgSeadragonPlugin",
    "version": "1.1.3",
    "status": "packaged",
    "description": "Contributes the Seadragon IIIF image viewer as an independently installable plugin. Registers a renderer with ahgIiifPlugin's RendererRegistry; install or disable it to choose the viewer.",
    "author": "The Archive and Heritage Group (Pty) Ltd",
    "license": "AGPL-3.0-or-later",
    "requires": {
        "atom": ">=2.10",
        "php": ">=8.1"
    },
    "dependencies": [
        "ahgIiifPlugin"
    ],
    "optional_dependencies": [],
    "theme_support": {
        "required": false
    },
    "distribution": {
        "tier": "community"
    },
    "provides_renderers": [
        {
            "name": "openseadragon-plugin",
            "priority": 15,
            "mime": "image/*"
        }
    ],
    "install": {
        "database": false
    },
    "tables": [],
    "category": "viewer",
    "vendor": {
        "openseadragon": {
            "version": "4.1.0",
            "source": "https://unpkg.com/openseadragon@4.1.0/build/openseadragon/openseadragon.min.js",
            "sha256": "4c9ca413d83ef99525abb30801ea80d7478707b8629522ed1183be00044ea36b",
            "bytes": 247016
        }
    }
}
