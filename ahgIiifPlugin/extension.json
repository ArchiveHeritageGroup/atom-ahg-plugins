{
    "machine_name": "ahgIiifPlugin",
    "name": "AHG IIIF Plugin",
    "version": "1.2.3",
    "license": "AGPL-3.0-or-later",
    "description": "IIIF viewer integration with Mirador and OpenSeadragon support",
    "author": "The Archive and Heritage Group",
    "category": "viewer",
    "dependencies": [
        "ahgCorePlugin"
    ],
    "optional_dependencies": [
        "ahg3DModelPlugin"
    ],
    "tables_created": [
        "iiif_collection",
        "iiif_collection_item"
    ],
    "provides": {
        "modules": [
            "iiif",
            "iiifCollection"
        ],
        "assets": [
            "mirador",
            "openseadragon"
        ]
    },
    "load_order": 80,
    "minimum_atom_version": "2.10.0",
    "tables": [
        "media_metadata",
        "media_chapters",
        "media_processing_queue",
        "media_processor_settings",
        "media_snippets",
        "media_transcription",
        "media_speakers",
        "iiif_annotation",
        "iiif_annotation_body",
        "iiif_collection",
        "iiif_collection_i18n",
        "iiif_collection_item",
        "iiif_ocr_block",
        "iiif_ocr_text",
        "iiif_viewer_settings",
        "iiif_auth_service",
        "iiif_auth_token",
        "iiif_auth_resource",
        "iiif_auth_repository",
        "iiif_auth_access_log",
        "iiif_manifest_cache",
        "iiif_saved_view",
        "media_audio_description",
        "iiif_ai_extract",
        "object_security_classification"
    ]
}
