{
    "name": "Condition Assessment",
    "machine_name": "ahgConditionPlugin",
    "version": "1.2.7",
    "description": "Condition assessment and reporting for museum objects",
    "author": "The Archive and Heritage Group",
    "license": "AGPL-3.0-or-later",
    "requires": {
        "atom_framework": ">=1.0.0",
        "atom": ">=2.8",
        "php": ">=8.1",
        "php_extensions": [
            "gd"
        ]
    },
    "dependencies": [
        "ahgCorePlugin"
    ],
    "optional": {
        "extensions": [
            "ahgMuseumPlugin"
        ]
    },
    "display_actions": [
        {
            "id": "condition_report_action",
            "label": "Condition Report",
            "icon": "bi-clipboard-check",
            "template": "ahgConditionPlugin/templates/display/_condition_report.php",
            "contexts": [
                "informationobject"
            ],
            "permission": "update",
            "weight": 40
        }
    ],
    "display_panels": [],
    "display_badges": [],
    "tables": [
        "condition_assessment_schedule",
        "condition_conservation_link",
        "condition_damage",
        "condition_event",
        "condition_image",
        "condition_report",
        "condition_vocabulary",
        "condition_vocabulary_term",
        "spectrum_condition_check",
        "spectrum_condition_check_data",
        "spectrum_condition_photo",
        "spectrum_condition_photo_comparison",
        "spectrum_condition_photos",
        "spectrum_condition_template",
        "spectrum_condition_template_field",
        "spectrum_condition_template_section"
    ],
    "shared_tables": [],
    "helpers": [],
    "category": "museum",
    "load_order": 50
}
