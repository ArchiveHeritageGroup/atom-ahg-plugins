{
    "name": "3D Model Viewer",
    "machine_name": "ahg3DModelPlugin",
    "version": "1.2.2",
    "description": "3D model viewing with Google Model Viewer, Gaussian Splat support, AR, hotspots, and IIIF 3D manifests",
    "author": "The Archive and Heritage Group",
    "license": "AGPL-3.0-or-later",
    "category": "ahg",
    "requires": {
        "atom_framework": ">=1.0.0",
        "atom": ">=2.8",
        "php": ">=8.1"
    },
    "dependencies": [
        "ahgCorePlugin"
    ],
    "install_sql": "database/install.sql",
    "tables": [
        "iiif_3d_manifest",
        "object_3d_audit_log",
        "object_3d_hotspot",
        "object_3d_hotspot_i18n",
        "object_3d_model",
        "object_3d_model_i18n",
        "object_3d_settings",
        "object_3d_texture",
        "viewer_3d_settings",
        "object_3d_camera_bookmark",
        "triposr_jobs"
    ]
}
