#!/usr/bin/env php
<?php

/**
 * Seed the archaeology vocabularies on an instance whose ProjectConfiguration is
 * stock.
 *
 * AtoM discovers CLI tasks from plugins enabled at PROJECT level, but stock
 * ProjectConfiguration::setup() enables a fixed list of base plugins and never
 * reads the `plugins` setting. AHG plugins are enabled by the APPLICATION
 * configuration instead, so on such an instance
 * `php symfony ahg:archaeology-seed-vocabularies` simply does not exist - the
 * task file is present, correct and unreachable. Measured on atom210,
 * 23 August 2026: the plugin runs in the web app, the namespace is absent on the
 * CLI.
 *
 * Base AtoM is NOT modified to fix this, on archaeology or anywhere else. This
 * runner boots the application configuration - the same one index.php uses - and
 * drives the task directly. Same approach as
 * ahgSiteRecordPlugin/bin/import-coordinates.
 *
 *   cd /usr/share/nginx/atom
 *   php plugins/ahgArchaeologyPlugin/bin/seed-vocabularies --dry-run
 *   php plugins/ahgArchaeologyPlugin/bin/seed-vocabularies
 */
$root = getcwd();

if (!is_file($root.'/config/ProjectConfiguration.class.php')) {
    fwrite(STDERR, "Run this from the AtoM root (where config/ProjectConfiguration.class.php lives).\n");

    exit(2);
}

require_once $root.'/config/ProjectConfiguration.class.php';

$env = getenv('ATOM_ENV') ?: 'prod';

// The third argument MUST stay false. Passing true rebuilds the configuration
// cache from the CLI and corrupts the cache the web app is serving from.
$configuration = ProjectConfiguration::getApplicationConfiguration('qubit', $env, false);

$dispatcher = $configuration->getEventDispatcher();
$formatter = new sfFormatter();

require_once __DIR__.'/../lib/task/archaeologySeedVocabulariesTask.class.php';

// sfTask::log() publishes to command.log and sfCommandApplication normally
// provides the listener. Driving the task directly there is none, so the task
// runs to completion and prints NOTHING - indistinguishable from a task that
// found no data. Attach a listener before the task can log anything.
$dispatcher->connect('command.log', function (sfEvent $event) {
    foreach ((array) $event->getParameters() as $line) {
        echo rtrim((string) $line)."\n";
    }
});

$task = new archaeologySeedVocabulariesTask($dispatcher, $formatter);

// sfBaseTask reads $this->configuration inside execute(); the constructor does
// not set it, so without this the task dies on sfContext::createInstance(null).
$task->setConfiguration($configuration);

$options = ['application' => 'qubit', 'env' => $env, 'culture' => 'en'];

foreach (array_slice($argv, 1) as $arg) {
    if (0 !== strpos($arg, '--')) {
        continue;
    }

    $arg = substr($arg, 2);

    if (false !== ($eq = strpos($arg, '='))) {
        $options[substr($arg, 0, $eq)] = substr($arg, $eq + 1);
    } else {
        $options[$arg] = true;
    }
}

$task->execute([], $options);
